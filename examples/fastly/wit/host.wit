// The donut's own world: a mock Fastly Compute host that runs one request
// through the embedded guest and reports what it sent downstream.
//
// The guest's world is `root:component/root` in deps/, decoded from the guest
// binary itself (`wasm-tools component wit rust.wasm --out-dir wit/deps`).
package test:fastly-host;

world host {
  // One request per instance: a Fastly Compute instance handles exactly one
  // request (the guest's Viceroy adapter asserts this).
  export serve: func(uri: string) -> string;
}
