package fastly:compute@0.1.0;

interface types {
  variant error {
    generic-error,
    invalid-argument,
    auxiliary-error,
    buffer-len(u64),
    unsupported,
    http-invalid,
    http-user,
    http-incomplete,
    cannot-read,
    http-head-too-large,
    http-invalid-status,
    limit-exceeded,
  }

  type ipv4-address = tuple<u8, u8, u8, u8>;

  type ipv6-address = tuple<u16, u16, u16, u16, u16, u16, u16, u16>;

  variant ip-address {
    ipv4(ipv4-address),
    ipv6(ipv6-address),
  }
}

interface async-io {
  resource pollable;
}

interface http-body {
  use async-io.{pollable as body};
  use types.{error};

  new: func() -> result<body, error>;

  append: func(dest: borrow<body>, src: body) -> result<_, error>;

  write: func(body: borrow<body>, buf: list<u8>) -> result<u32, error>;

  write-front: func(body: borrow<body>, buf: list<u8>) -> result<_, error>;

  close: func(body: body) -> result<_, error>;

  get-known-length: func(body: borrow<body>) -> option<u64>;
}

interface http-types {
  enum http-version {
    http09,
    http10,
    http11,
    h2,
    h3,
  }

  type http-status = u16;

  enum framing-headers-mode {
    automatic,
    manually-from-headers,
  }
}

interface http-resp {
  use types.{error};
  use http-types.{http-version, http-status, framing-headers-mode};
  use types.{ip-address};
  use http-body.{body};

  resource response {
    new: static func() -> result<response, error>;
    get-header-names: func(max-len: u64, cursor: u32) -> result<tuple<string, option<u32>>, error>;
    get-header-values: func(name: string, max-len: u64, cursor: u32) -> result<tuple<list<u8>, option<u32>>, error>;
    insert-header: func(name: string, value: list<u8>) -> result<_, error>;
    append-header: func(name: string, value: list<u8>) -> result<_, error>;
    get-version: func() -> result<http-version, error>;
    set-version: func(version: http-version) -> result<_, error>;
    get-status: func() -> result<http-status, error>;
    set-status: func(status: http-status) -> result<_, error>;
    set-framing-headers-mode: func(mode: framing-headers-mode) -> result<_, error>;
    set-http-keepalive-mode: func(mode: keepalive-mode) -> result<_, error>;
    get-remote-ip-addr: func() -> option<ip-address>;
    get-remote-port: func() -> option<u16>;
  }

  enum keepalive-mode {
    automatic,
    no-keepalive,
  }

  type response-with-body = tuple<response, body>;

  send-downstream: func(response: response, body: body) -> result<_, error>;

  send-downstream-streaming: func(response: response, body: borrow<body>) -> result<_, error>;

  close: func(response: response) -> result<_, error>;
}

interface http-req {
  use types.{error};
  use http-types.{http-version};
  use async-io.{pollable as pending-response};
  use http-resp.{response-with-body};

  resource request {
    get-method: func(max-len: u64) -> result<string, error>;
    set-method: func(method: string) -> result<_, error>;
    get-uri: func(max-len: u64) -> result<string, error>;
    set-uri: func(uri: string) -> result<_, error>;
    get-version: func() -> result<http-version, error>;
    set-version: func(version: http-version) -> result<_, error>;
  }

  record dns-error-detail {
    rcode: option<u16>,
    info-code: option<u16>,
  }

  record tls-alert-received-detail {
    id: option<u8>,
  }

  record h2-error-detail {
    frame-type: u8,
    error-code: u32,
  }

  resource extra-send-error-detail;

  variant send-error-detail {
    dns-timeout,
    dns-error(dns-error-detail),
    destination-not-found,
    destination-unavailable,
    destination-ip-unroutable,
    connection-refused,
    connection-terminated,
    connection-timeout,
    connection-limit-reached,
    tls-certificate-error,
    tls-configuration-error,
    http-incomplete-response,
    http-response-header-section-too-large,
    http-response-body-too-large,
    http-response-timeout,
    http-response-status-invalid,
    http-upgrade-failed,
    http-protocol-error,
    http-request-cache-key-invalid,
    http-request-uri-invalid,
    internal-error,
    tls-alert-received(tls-alert-received-detail),
    tls-protocol-error,
    h2-error(h2-error-detail),
    extra(extra-send-error-detail),
  }

  record error-with-detail {
    detail: option<send-error-detail>,
    error: error,
  }

  enum client-cert-verify-result {
    ok,
    bad-certificate,
    certificate-revoked,
    certificate-expired,
    unknown-ca,
    certificate-missing,
    certificate-unknown,
  }

  await-response: func(pending: pending-response) -> result<response-with-body, error-with-detail>;

  close: func(request: request) -> result<_, error>;
}

interface cache {
  type duration-ns = u64;

  type object-length = u64;
}

interface http-cache {
  use http-resp.{response};
  use cache.{duration-ns, object-length};
  use http-body.{body};
  use types.{error};

  resource entry {
    transaction-insert: func(resp-handle: response, options: write-options) -> result<body, error>;
    transaction-update: func(resp-handle: response, options: write-options) -> result<_, error>;
    transaction-record-not-cacheable: func(options: write-options) -> result<_, error>;
    get-suggested-write-options: func(response: borrow<response>) -> result<suggested-write-options, error>;
    prepare-response-for-storage: func(response: borrow<response>) -> result<tuple<storage-action, response>, error>;
    transaction-abandon: func() -> result<_, error>;
  }

  resource extra-write-options;

  record write-options {
    max-age-ns: duration-ns,
    vary-rule: option<string>,
    initial-age-ns: option<duration-ns>,
    stale-while-revalidate-ns: option<duration-ns>,
    stale-if-error-ns: option<duration-ns>,
    surrogate-keys: option<string>,
    length: option<object-length>,
    sensitive-data: bool,
    extra: option<borrow<extra-write-options>>,
  }

  resource suggested-write-options {
    get-max-age-ns: func() -> duration-ns;
    get-vary-rule: func(max-len: u64) -> result<string, error>;
    get-initial-age-ns: func() -> duration-ns;
    get-stale-while-revalidate-ns: func() -> duration-ns;
    get-surrogate-keys: func(max-len: u64) -> result<string, error>;
    get-length: func() -> option<object-length>;
    get-sensitive-data: func() -> bool;
  }

  enum storage-action {
    insert,
    update,
    do-not-store,
    record-uncacheable,
  }

  close-entry: func(handle: entry) -> result<_, error>;
}

interface http-downstream {
  use http-req.{request};
  use types.{ip-address, error};
  use http-req.{client-cert-verify-result};

  downstream-client-ip-addr: func(ds-request: borrow<request>) -> option<ip-address>;

  downstream-server-ip-addr: func(ds-request: borrow<request>) -> option<ip-address>;

  downstream-client-h2-fingerprint: func(ds-request: borrow<request>, max-len: u64) -> result<string, error>;

  downstream-client-request-id: func(ds-request: borrow<request>, max-len: u64) -> result<string, error>;

  downstream-client-oh-fingerprint: func(ds-request: borrow<request>, max-len: u64) -> result<string, error>;

  downstream-client-ddos-detected: func(ds-request: borrow<request>) -> result<bool, error>;

  downstream-tls-cipher-openssl-name: func(ds-request: borrow<request>, max-len: u64) -> result<option<list<u8>>, error>;

  downstream-tls-protocol: func(ds-request: borrow<request>, max-len: u64) -> result<option<list<u8>>, error>;

  downstream-tls-client-hello: func(ds-request: borrow<request>, max-len: u64) -> result<option<list<u8>>, error>;

  downstream-tls-raw-client-certificate: func(ds-request: borrow<request>, max-len: u64) -> result<option<list<u8>>, error>;

  downstream-tls-client-cert-verify-result: func(ds-request: borrow<request>) -> result<option<client-cert-verify-result>, error>;

  downstream-tls-client-servername: func(ds-request: borrow<request>, max-len: u64) -> result<option<string>, error>;

  downstream-tls-ja3-md5: func(ds-request: borrow<request>) -> result<option<list<u8>>, error>;

  downstream-tls-ja4: func(ds-request: borrow<request>, max-len: u64) -> result<option<string>, error>;

  downstream-compliance-region: func(ds-request: borrow<request>, max-len: u64) -> result<option<string>, error>;

  fastly-key-is-valid: func(ds-request: borrow<request>) -> result<bool, error>;
}

interface http-incoming {
  use http-body.{body};
  use http-req.{request};

  handle: func(request: request, body: body) -> result;
}

