package example:app;

/// Requests, as in `wasi:http/types`.
interface types {
  resource request {
    constructor(url: string);
    url: func() -> string;
    set-header: func(name: string, value: string);
  }
}

interface outgoing {
  use types.{request};
  send: func(r: request) -> result<u16, string>;
}

/// What the app exports.
interface handler {
  handle: func(path: string) -> string;
}

/// A filesystem: the app's old platform had one, the new host doesn't.
interface fs {
  resource file {
    read: func() -> string;
    write: func(data: string);
  }
  open: func(path: string) -> result<file, string>;
}

/// A secret vault: the new host has one, and the app must never see it.
interface secrets {
  resource vault {
    open: static func(name: string) -> vault;
    get: func(key: string) -> option<string>;
  }
}

/// The app (the guest).
world app {
  import outgoing;
  import fs;
  export handler;
}

/// The host it now runs on (the donut's world).
world host {
  import outgoing;
  import secrets;
  export handler;
}
